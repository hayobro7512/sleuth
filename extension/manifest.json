{
  "manifest_version": 3,
  "name": "Sign-up Shield",
  "version": "0.1.0",
  "description": "Quietly highlights pressure tactics on cookie banners, free trials, and checkout pages.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8787/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
